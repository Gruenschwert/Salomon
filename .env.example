# Telegram
TELEGRAM_BOT_TOKEN=
# Komma-getrennt, z. B. 123456789,987654321
# Gilt nur für die erste Einrichtung; weitere Personen legt ein Admin mit /nutzer_neu an
TELEGRAM_ALLOWED_USER_IDS=
# Teilmenge der erlaubten IDs. Diese Konten sind Admins und lassen sich nicht aussperren
TELEGRAM_ADMIN_USER_IDS=

# Anthropic
ANTHROPIC_API_KEY=
# Optional. Wird als Header anthropic-workspace-id mitgeschickt
ANTHROPIC_WORKSPACE_ID=
# Modellstufen. Der Bot wählt je Nachricht nach festen Regeln; /modell legt die Stufe fest
# Kurze Lesefragen
MODEL_EINFACH=claude-haiku-4-5-20251001
# Alles andere. Ist der Wert leer, gilt ein vorhandenes MODEL_DEFAULT
MODEL_STANDARD=claude-sonnet-5-5
# Fotos, PDFs, lange Nachrichten, Analysen
MODEL_KOMPLEX=claude-opus-5-5
# Höchstzahl der Runden je Nachricht; danach meldet der Bot den Zwischenstand
AGENT_MAX_ROUNDS=25
# Muss für große Asana-Änderungssätze reichen (rund 100 Operationen)
MAX_OUTPUT_TOKENS=8000
# Tageslimit pro Person in Euro. Ein Admin kann es je Person mit /limit ändern
DAILY_COST_LIMIT_EUR=5
# Tageslimit für alle zusammen in Euro
DAILY_COST_LIMIT_TOTAL_EUR=20
HISTORY_MAX_MESSAGES=20

# Nachrichten im Verlauf werden nach so vielen Tagen gelöscht
MESSAGE_RETENTION_DAYS=90

# Kostenberechnung. Die Preise der bekannten Modelle stehen im Code (app/agent/preise.py)
# Die beiden Werte gelten nur für Modelle, die dort fehlen
# USD pro 1 Mio. Input-Tokens
PRICE_INPUT_USD_PER_MTOK=2.00
# USD pro 1 Mio. Output-Tokens
PRICE_OUTPUT_USD_PER_MTOK=10.00
# Fester Umrechnungskurs, z. B. 0.90 (1 USD = 0,90 EUR)
USD_EUR_RATE=

# Datenbank
POSTGRES_USER=gs
POSTGRES_PASSWORD=
POSTGRES_DB=gs_assistant
DATABASE_URL=postgresql+asyncpg://gs:${POSTGRES_PASSWORD}@db:5432/gs_assistant
# Optional. Eigener Datenbank-Login nur für den Bot, siehe README (Datenschutz)
APP_DATABASE_URL=

# Verschlüsselung der persönlichen Zugänge (/verbinden). 32 Byte, Base64
# Erzeugen: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SECRETS_MASTER_KEY=
# Nur beim Schlüsselwechsel ändern, siehe README
SECRETS_MASTER_KEY_VERSION=1
# Nur während eines Schlüsselwechsels: der bisherige Schlüssel
SECRETS_MASTER_KEY_ALT=

# Shopify (je Shop ein Block; Custom App mit NUR Leserechten)
SHOPIFY_CANASUPS_DOMAIN=
SHOPIFY_CANASUPS_TOKEN=
SHOPIFY_KIFFKRAUT_DOMAIN=
SHOPIFY_KIFFKRAUT_TOKEN=
# Aktuelle stabile Version eintragen
SHOPIFY_API_VERSION=

# Asana Personal Access Token des ersten Admins. Wird beim Start einmal in dessen
# verschlüsselten Zugang übernommen; alle anderen verbinden sich selbst mit /verbinden asana
ASANA_TOKEN=
# Optional. Leer lassen, wenn der Token genau einen Workspace sieht
ASANA_WORKSPACE_GID=
# Optional. Team für neue Projekte (nur bei Organisations-Workspaces nötig)
ASANA_DEFAULT_TEAM_GID=
# Maximale Zahl Operationen pro Änderungssatz
ASANA_MAX_OPS_PER_CHANGESET=100
# Maximale Zahl Löschoperationen pro Änderungssatz
ASANA_MAX_DELETES_PER_CHANGESET=20
# Löschen erlauben (true/false)
ASANA_DELETE_ENABLED=true
# Maximale Bildgröße für Fotos in MB
PHOTO_MAX_MB=5
# Maximale Größe eines Asana-Anhangs (Bild oder PDF), den der Bot zum Lesen herunterlädt, in MB
ASANA_ATTACHMENT_VIEW_MAX_MB=5
# Allgemeiner Asana-API-Aufruf als Auffangnetz (true/false)
ASANA_API_AUFRUF_ENABLED=true

TZ=Europe/Berlin
